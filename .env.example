# Copy to .env and replace both passwords before starting MySQL.
APP_ENV=development
PORT=8080
# Production requires both files and serves the REST API over TLS 1.2+.
# Development uses HTTP only when both values are intentionally left empty.
REST_TLS_CERT_FILE=
REST_TLS_KEY_FILE=
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=collab_editor
MYSQL_USER=collab
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_PORT=3306

STORAGE_DRIVER=mysql
MYSQL_DSN=collab:replace-with-a-local-app-password@tcp(127.0.0.1:3306)/collab_editor?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=5m
MYSQL_PING_TIMEOUT=5s
MYSQL_QUERY_TIMEOUT=5s

# Room recovery and in-memory operation history
SNAPSHOT_INTERVAL=100
MAX_HISTORY_OPERATIONS=1000
SNAPSHOT_TIMEOUT=5s

# QUIC transport (TLS 1.3, UDP)
QUIC_ADDR=:8443
QUIC_TLS_CERT_FILE=certs/server.crt
QUIC_TLS_KEY_FILE=certs/server.key
QUIC_CA_FILE=certs/ca.crt
QUIC_HANDSHAKE_TIMEOUT=5s
QUIC_IDLE_TIMEOUT=60s
QUIC_KEEPALIVE_PERIOD=20s
QUIC_AUTH_TIMEOUT=10s
QUIC_READ_TIMEOUT=2m
QUIC_WRITE_TIMEOUT=10s
QUIC_OPERATION_TIMEOUT=10s
QUIC_MAX_MESSAGE_SIZE=1048576
QUIC_SEND_QUEUE_SIZE=32
QUIC_MAX_CONNECTIONS=1000

AUTH_MODE=jwt
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=collab-editor
JWT_AUDIENCE=collab-editor-api
JWT_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_REPLAY_TTL=10m
# base64 of an independent random 32-byte key; do not reuse JWT_SECRET
REFRESH_REPLAY_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_DB=0
REDIS_PORT=6379
# Set these when the Redis service enables in-transit encryption.
REDIS_TLS_CA_FILE=
REDIS_TLS_SERVER_NAME=

# Browser origins are exact matches. Production accepts HTTPS origins only.
CORS_ALLOWED_ORIGINS=https://editor.example.com
LOGIN_RATE_LIMIT=20
REFRESH_RATE_LIMIT=60
INTERNAL_RPC_RATE_LIMIT=300
RATE_LIMIT_WINDOW=1m

# Management endpoints. Bind only to loopback or a private management network.
ADMIN_ADDR=127.0.0.1:9090
# Leave empty for the built-in no-op trace exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false

# Cluster discovery. Keep single for the standalone demo.
CLUSTER_MODE=single
# NODE_ID=node-a
# NODE_INCARNATION must match the incarnation encoded in the internal RPC
# certificate URI SAN: spiffe://collab-editor/node/<node-id>/incarnation/<incarnation>
# NODE_INCARNATION=replace-with-ca-issued-incarnation
# NODE_QUIC_ENDPOINT=node-a.example.com:8443
# Internal mTLS RPC endpoint. Browsers must never be redirected here.
# NODE_HTTP_ENDPOINT=https://node-a.example.com:9443
# Public HTTPS endpoint used only for browser Owner Redirect.
# NODE_BROWSER_ENDPOINT=https://node-a.example.com:8080
# ETCD_ENDPOINTS=https://etcd-a.example.com:2379,https://etcd-b.example.com:2379
# ETCD_USERNAME=
# ETCD_PASSWORD=
# ETCD_CA_FILE=certs/etcd-ca.crt
# ETCD_CERT_FILE=certs/etcd-client.crt
# ETCD_KEY_FILE=certs/etcd-client.key
# ETCD_LEASE_TTL=10s
# ETCD_DIAL_TIMEOUT=5s
# ETCD_REQUEST_TIMEOUT=5s
# INTERNAL_RPC_ADDR=:9443
# INTERNAL_RPC_CA_FILE=certs/internal-ca.crt
# INTERNAL_RPC_CERT_FILE=certs/node.crt
# INTERNAL_RPC_KEY_FILE=certs/node.key
# INTERNAL_RPC_TIMEOUT=5s

# QUIC CLI (client-side only; never commit real tokens)
COLLAB_QUIC_ADDR=localhost:8443
COLLAB_API_URL=http://localhost:8080
COLLAB_CA_FILE=certs/ca.crt
COLLAB_SERVER_NAME=localhost
COLLAB_CLIENT_PROFILE=default
# COLLAB_CLIENT_STATE_DIR=
# COLLAB_ACCESS_TOKEN=
# COLLAB_REFRESH_TOKEN=
