ARG GO_IMAGE=golang:1.26.10-bookworm

FROM ${GO_IMAGE} AS build
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
COPY go.mod go.sum ./
RUN GOPROXY=${GOPROXY} go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/collab-runner ./cmd/runner

FROM docker:29.2.1-cli
COPY --from=build /out/collab-runner /usr/local/bin/collab-runner
ENTRYPOINT ["/usr/local/bin/collab-runner"]
